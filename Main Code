
#include <ps5Controller.h>  // PS5 library, to connect to controller
#include <SCServo.h>        // UART communicating servo library

SMS_STS sts;                // creates an instance of SMS_STS class --> from SCServo

bool wasConnected = false;  // previous connection of controller, for debug

int servoBasePos[6] = {3072, 1950, 3050, 3050, 2075, 3175};  // array of servo center positions

int lastLegUsed = 0;  // 0 = rightLeg, 1 = leftLeg

// servo IDs

int hip_dx = 1;
int hip_sx = 4;

int knee_dx = 2;
int knee_sx = 5;

int ankle_dx = 3;
int ankle_sx = 6;

int posY = 2048;
int posX = 2048;

// robot current rotation variables

int rotation;
int rX = 0;
int rY = 1;

bool isMoving = false; // moving flag

String debug = "";     // string used for Serial communication (debug only)

void setup() {
  Serial.begin(115200);

  // UART communication Setup

  Serial1.begin(1000000, SERIAL_8N1, 18, 19);
  sts.pSerial = &Serial1;                      

  ps5.begin("24:a6:fa:30:33:a5"); // controller MAC address, change with own
  
  Serial.println("online");
  Serial.println("connect PS5 controller");

  resetServoPos();  // force servo reset to central position
}

void loop() {
  debug = Serial.readString();
  debug.trim();

  if (!ps5.isConnected()) 
  {
    if (wasConnected) Serial.println("reconnect PS5 controller");
    wasConnected = false;
    delay(10);
  }

  wasConnected = true;

  if ((ps5.Up() || debug == "w") && !isMoving) forward();
  if ((ps5.Down() || debug == "s") && !isMoving) back();

  if ((ps5.Right() || debug == "d") && !isMoving) right();
  if ((ps5.Left() || debug == "a") && !isMoving) left();
}

void setServo(int id, int pos)
{
  sts.WritePosEx(id, pos, 400, 50); // function to set servo to position (id, position, speed, accelleration)
}

void resetServoPos()
{
  for(int i = 1; i <= 6; i++)
  {
    setServo(i, servoBasePos[i - 1]);
  }
}

// movement functions

void step()
{
  if (lastLegUsed == 0)
  {
    setServo(knee_sx, servoBasePos[knee_sx - 1] + 200);
    setServo(knee_dx, servoBasePos[knee_dx - 1] + 200);

    setServo(ankle_dx, servoBasePos[ankle_dx - 1] - 200);
    setServo(ankle_sx, servoBasePos[ankle_sx - 1] - 200);

    delay(1000);

    setServo(knee_dx, servoBasePos[knee_dx - 1]);
    setServo(knee_sx, servoBasePos[knee_sx - 1]);

    setServo(ankle_sx, servoBasePos[ankle_sx - 1]);
    setServo(ankle_dx, servoBasePos[ankle_dx - 1]);

    lastLegUsed = 1;
  }
  else
  {
    setServo(knee_dx, servoBasePos[knee_dx - 1] - 200);
    setServo(knee_sx, servoBasePos[knee_sx - 1] - 200);

    setServo(ankle_sx, servoBasePos[ankle_sx - 1] + 200);
    setServo(ankle_dx, servoBasePos[ankle_dx - 1] + 200);

    delay(1000);

    setServo(ankle_dx, servoBasePos[ankle_dx - 1]);
    setServo(ankle_sx, servoBasePos[ankle_sx - 1]);

    setServo(knee_sx, servoBasePos[knee_sx - 1]);
    setServo(knee_dx, servoBasePos[knee_dx - 1]);

    lastLegUsed = 0;
  }
}

void forward()
{
  isMoving = true;
  rotateTo(0, 1);
  delay(1000);
  step();
  isMoving = false;
}

void left()
{
  isMoving = true;
  rotateTo(-1, 0);
  delay(1000);
  step();
  isMoving = false;
}

void right()
{
  isMoving = true;
  rotateTo(1, 0);
  delay(1000);
  step();
  isMoving = false;
}

void back()
{
  isMoving = true;
  rotateTo(0, -1);
  delay(1000);
  step();
  isMoving = false;
}

// rotation function

void rotateTo(int x, int y)
{
  if (rX == x && rY == y) return;

  rX = x;
  rY = y;

  setServo(knee_sx, 3072);

  rotation = 4095;

  if (y == -1) rotation = 1024;
  else if (y == 1) rotation = 3072;
  else if (x == 1) rotation = 2048;

  setServo(knee_sx, servoBasePos[knee_sx - 1] - 50);

  delay(500);

  setServo(hip_dx, rotation);

  delay(2600);

  setServo(knee_sx, servoBasePos[knee_sx - 1]);
  setServo(hip_dx, servoBasePos[hip_dx - 1]);

  delay(500);

  // until servo aren't delivered
  rX = 0;
  rY = 1;
}
