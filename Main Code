
#include <SCServo.h>
#include <PS5Controller.h>

SMS_STS sts;

int hip1_right;
int hip2_right;
int knee_right;
int ankle1_right;
int ankle2_right;

int hip1_left;
int hip2_left;
int knee_left;
int ankle1_left;
int ankle2_left;

int rotation;
int rX = 0;
int rY = 1;

bool isMoving = false;

void setup() 
{
  PS5.begin();

  resetServoPos();
}

void loop() 
{
  if (PS5.isConnected() && !isMoving)
  {
    if (PS5.Up()) forward();

    else if (PS5.Left()) left();

    else if (PS5.Right()) right();

    else if (PS5.Back()) back();
  }
}

// servo base functions

void setServo(int id, int pos)
{
  sts.WritePosEx(id, pos, 400, 50);
  delay(1000);
}

void resetServoPos()
{
  for (int i = 1; i <= 10; i++)
  {
    setServo(i, 2048);
  }
}

// movement functions

void step()
{

}

void forward()
{
  isMoving = true;
  rotateTo(0, 1);
  step();
  isMoving = false;
}

void left()
{
  isMoving = true;
  rotateTo(-1, 0);
  step();
  isMoving = false;
}

void right()
{
  isMoving = true;
  rotateTo(1, 0);
  step();
  isMoving = false;
}

void back()
{
  isMoving = true;
  rotateTo(0, -1);
  step();
  isMoving = false;
}

// rotation function

void rotateTo(int x, int y)
{
  if (rX == x && rY == y)
    return;

  rX = x; rY = y;

  rotation = 2048;

  if(y == -1) rotation = 0;
  else if (x == 1) rotation += rotation / 2;
  else if (x == -1) rotation -= rotation / 2;
}
